<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Assessments.Set3</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <!-- Your queries, or the worked ones with -p:UseReference=true, are copied to Queries/ in the output. -->
  <ItemGroup Condition="'$(UseReference)' != 'true'">
    <None Include="Problems/*.sql" Link="Queries/%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseReference)' == 'true'">
    <None Include="Reference/*.sql" Link="Queries/%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Data/*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
