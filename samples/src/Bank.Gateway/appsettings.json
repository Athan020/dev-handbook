{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "SigningKey": "lab-only-signing-key-change-me-0123456789abcdef",
    "RatePerSecond": 20,
    "Burst": 40
  },
  "ReverseProxy": {
    "Routes": {
      "payees": {
        "ClusterId": "payees",
        "Order": 1,
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "per-customer",
        "Match": {
          "Path": "/accounts/{accountId}/payees/{**rest}"
        }
      },
      "statements": {
        "ClusterId": "statements",
        "Order": 1,
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "per-customer",
        "Match": {
          "Path": "/accounts/{accountId}/statements/{**rest}"
        }
      },
      "accounts": {
        "ClusterId": "ledger",
        "Order": 2,
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "per-customer",
        "Match": {
          "Path": "/accounts/{accountId}/{**rest}"
        }
      },
      "transfers": {
        "ClusterId": "ledger",
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "per-customer",
        "Match": {
          "Path": "/transfers/{**rest}"
        }
      },
      "card-top-ups": {
        "ClusterId": "ledger",
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "per-customer",
        "Match": {
          "Path": "/card-top-ups",
          "Methods": [
            "POST"
          ]
        }
      },
      "card-top-up": {
        "ClusterId": "ledger",
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "per-customer",
        "Match": {
          "Path": "/card-top-ups/{topUpId}",
          "Methods": [
            "GET"
          ]
        }
      }
    },
    "Clusters": {
      "ledger": {
        "Destinations": {
          "main": {
            "Address": "http://localhost:5100"
          }
        }
      },
      "payees": {
        "Destinations": {
          "main": {
            "Address": "http://localhost:5101"
          },
          "service": {
            "Address": "http://localhost:5103"
          }
        }
      },
      "statements": {
        "Destinations": {
          "main": {
            "Address": "http://localhost:5102"
          }
        }
      }
    }
  }
}
